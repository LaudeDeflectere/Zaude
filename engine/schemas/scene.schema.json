{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zaude.local/schemas/scene.schema.json",
  "title": "Zaude scene",
  "description": "Structure of a scene file. Rules that JSON Schema cannot express (overlaps, clip names, ids unique, times inside the duration) are enforced by zaude_engine.scene.validate_scene.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "fps", "duration", "coordinate_system", "cameras"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "fps": {"type": "number", "minimum": 1, "maximum": 120},
    "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 600},
    "coordinate_system": {"const": "z_up_right_handed_metres"},
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["humanoid"]},
          "position": {"$ref": "#/$defs/vec3"},
          "yaw_deg": {"type": "number"},
          "animations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clip", "start", "end"],
              "properties": {
                "clip": {"enum": ["idle", "raise_right_arm"]},
                "start": {"type": "number", "minimum": 0},
                "end": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "start": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "target"],
            "properties": {
              "position": {"$ref": "#/$defs/vec3"},
              "target": {"$ref": "#/$defs/vec3"},
              "focal_mm": {"type": "number", "minimum": 1, "maximum": 500}
            }
          },
          "motions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "start", "end"],
              "properties": {
                "kind": {"enum": ["orbit", "pan", "tilt", "dolly", "track", "zoom", "hold"]},
                "start": {"type": "number", "minimum": 0},
                "end": {"type": "number", "minimum": 0},
                "ease": {"enum": ["linear", "smooth", "hold"]},
                "degrees": {"type": "number"},
                "centre": {"$ref": "#/$defs/vec3"},
                "metres": {"type": "number"},
                "to_mm": {"type": "number", "minimum": 1, "maximum": 500}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
  }
}
